{
  "name": "writing-tools",
  "version": "0.0.0",
  "description": "Japanese writing tools for coding agents: a neutral inspector and the skill that uses it.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craft-agent"
  },
  "homepage": "https://github.com/craft-agent/writing-tools#readme",
  "repository": "https://github.com/craft-agent/writing-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "writing-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "WRITING_TOOLS_TOOLSETS",
        "WRITING_TOOLS_READ_ONLY",
        "WRITING_TOOLS_TOOLS",
        "WRITING_TOOLS_EXCLUDE_TOOLS",
        "WRITING_TOOLS_CONFIRM",
        "WRITING_TOOLS_UNATTENDED",
        "WRITING_TOOLS_GRANTS_DIR",
        "WRITING_TOOLS_STATE_DIR",
        "WRITING_TOOLS_REGISTER",
        "WRITING_TOOLS_LATIN_SPACING",
        "WRITING_TOOLS_UNIT_SPACING",
        "WRITING_TOOLS_ALNUM_WIDTH",
        "WRITING_TOOLS_BRACKET_WIDTH",
        "WRITING_TOOLS_PUNCTUATION",
        "WRITING_TOOLS_QUOTES",
        "WRITING_TOOLS_RANGE_MARK",
        "WRITING_TOOLS_LONG_VOWEL",
        "WRITING_TOOLS_COUNTER_KA",
        "WRITING_TOOLS_RULES",
        "WRITING_TOOLS_EXCLUDE_RULES",
        "WRITING_TOOLS_GRANT_KEY",
        "XDG_STATE_HOME"
      ]
    }
  }
}
